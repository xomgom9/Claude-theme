{% liquid
  assign offer_product = section.settings.product
  if offer_product == blank and request.page_type == 'product'
    assign offer_product = product
  endif
  assign selected_variant = offer_product.selected_or_first_available_variant
  assign product_image = offer_product.featured_image
  assign product_form_id = 'cc-product-form-' | append: section.id
  assign product_rating = section.settings.rating_score
  assign product_review_count = section.settings.review_count
  assign product_sold_count = section.settings.sold_count
  assign product_rating_percent = product_rating | times: 20
%}

<!-- Claude-theme storefront build: 2026-08-18 -->
<div class="cc-landing" id="top">
  <div class="cc-page-progress" aria-hidden="true"><span data-cc-page-progress></span></div>
  <div class="cc-announcement" role="region" aria-label="Special offers">
    <div class="cc-marquee">
      <span>30% OFF BUNDLES</span><span>30-Day Money-Back Guarantee</span><span>24/7 Quality Customer Service</span><span>Powered by Real Users</span>
    </div>
  </div>

  <header class="cc-header">
    <a class="cc-logo" href="#top" aria-label="{{ section.settings.brand_name | escape }} home">
      <img
        class="cc-logo-image"
        src="{{ 'logo.png' | asset_url }}"
        width="2048"
        height="768"
        loading="eager"
        alt="{{ section.settings.brand_name | escape }}"
      >
    </a>
    <button class="cc-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="cc-mobile-menu-{{ section.id }}" data-cc-menu-open>
      <span></span><span></span><span></span>
    </button>
    <nav class="cc-nav" aria-label="Landing page navigation">
      <a href="#special-offer">SPECIAL OFFER</a><a href="#guarantees">GUARANTEES</a><a href="#faq">FAQ</a>
    </nav>
    <div class="cc-header-actions">
      <a class="cc-header-icon" href="{{ routes.account_url }}" aria-label="Track your order in your Shopify account">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"></path>
          <circle cx="7" cy="18" r="2"></circle>
          <circle cx="18" cy="18" r="2"></circle>
        </svg>
      </a>
      <a class="cc-header-icon" href="{{ routes.cart_url }}" aria-label="View cart">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20 8H7"></path>
          <circle cx="10" cy="20" r="1.5"></circle>
          <circle cx="17" cy="20" r="1.5"></circle>
        </svg>
      </a>
      <a class="cc-button cc-header-cta" href="#special-offer">SHOP NOW</a>
    </div>
    <div class="cc-menu-overlay" data-cc-menu-overlay></div>
    <aside class="cc-mobile-menu" id="cc-mobile-menu-{{ section.id }}" aria-hidden="true" data-cc-mobile-menu>
      <div class="cc-mobile-menu-head">
        <span>MENU</span>
        <button type="button" aria-label="Close menu" data-cc-menu-close>&times;</button>
      </div>
      <nav aria-label="Mobile navigation">
        <a href="#special-offer">SPECIAL OFFER</a>
        <a href="#guarantees">GUARANTEES</a>
        <a href="#faq">FAQ</a>
        <a href="{{ routes.account_url }}">TRACK ORDER</a>
        <a href="{{ routes.cart_url }}">CART</a>
      </nav>
      <a class="cc-button cc-mobile-shop" href="#special-offer">SHOP NOW</a>
    </aside>
  </header>

  <div class="cc-main">
    <section class="cc-hero">
      <div class="cc-hero-media">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 2000 | image_tag: widths: '480, 750, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', decoding: 'async', alt: section.settings.hero_image.alt }}
        {% else %}
          <img
            src="{{ 'background-hero-banner.png' | asset_url }}"
            width="1854"
            height="848"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            alt="{{ section.settings.hero_heading | escape }}"
          >
        {% endif %}
      </div>
      <div class="cc-hero-overlay"></div>
      <div class="cc-wrap cc-hero-content">
        <div class="cc-hero-card">
          <p class="cc-hero-pill">Car Neck Support Pillow</p>
          <h1>Gentle Neck Support Mile After Mile</h1>
          <p class="cc-hero-description">Enjoy softer, steadier support on every drive with a contoured pillow designed to cradle your neck in cloud-soft comfort.</p>
          <div class="cc-hero-benefits" aria-label="Product benefits">
            <div class="cc-hero-benefit"><span aria-hidden="true">⌒</span><strong>Neck-Cradling Design</strong></div>
            <div class="cc-hero-benefit"><span aria-hidden="true">◇</span><strong>Cloud-Soft Memory Foam</strong></div>
          </div>
          <a class="cc-button cc-hero-cta" href="#special-offer"><span>Buy Now · Save 50%</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="cc-section cc-wrap" aria-labelledby="pain-title">
      <div class="cc-heading"><p class="cc-eyebrow">THE DAILY DRIVE</p><h2 id="pain-title">Still Feeling Sore After Driving?</h2><p>Long hours behind the wheel can leave your neck, shoulders, and back feeling worn out.</p></div>
      <div class="cc-pain-grid">
        <article class="cc-media-card">
          <div class="cc-card-media">{% if section.settings.pain_image_1 != blank %}{{ section.settings.pain_image_1 | image_url: width: 900 | image_tag: widths: '400, 700, 900', loading: 'lazy', alt: section.settings.pain_image_1.alt }}{% else %}<img src="{{ 'shoulder-back-strain.jpg' | asset_url }}" width="900" height="600" loading="lazy" alt="Driver experiencing shoulder and back strain">{% endif %}</div>
          <div class="cc-card-copy"><span class="cc-icon"><img src="{{ 'shoulder-back-strain.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><h3>Shoulder &amp; Back Strain</h3><p>Tension builds up during long hours behind the wheel.</p></div>
        </article>
        <article class="cc-media-card">
          <div class="cc-card-media">{% if section.settings.pain_image_2 != blank %}{{ section.settings.pain_image_2 | image_url: width: 900 | image_tag: widths: '400, 700, 900', loading: 'lazy', alt: section.settings.pain_image_2.alt }}{% else %}<img src="{{ 'neck-pain-stiffness.jpg' | asset_url }}" width="900" height="600" loading="lazy" alt="Driver experiencing neck pain and stiffness">{% endif %}</div>
          <div class="cc-card-copy"><span class="cc-icon"><img src="{{ 'neck-pain-stiffness.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><h3>Neck Pain &amp; Stiffness</h3><p>Lack of support puts extra strain on your neck.</p></div>
        </article>
        <article class="cc-video-card">
          {% if section.settings.pain_video != blank %}
            {{ section.settings.pain_video | video_tag: autoplay: true, controls: false, muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '1200x', class: 'cc-pain-hover-video' }}
          {% elsif section.settings.video_cover != blank %}
            {{ section.settings.video_cover | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', loading: 'lazy', alt: section.settings.video_cover.alt }}
          {% else %}
            <video class="cc-pain-hover-video" autoplay muted loop playsinline preload="metadata" aria-label="Still Feeling Sore After Driving video">
              <source src="{{ 'video Still Feeling Sore After Driving.mp4' | asset_url }}" type="video/mp4">
            </video>
          {% endif %}
        </article>
      </div>
    </section>

    <section class="cc-section cc-soft">
      <div class="cc-wrap">
        <div class="cc-heading"><p class="cc-eyebrow">360° COMFORT</p><h2>Soft Support From Every Angle</h2><p>3D contouring fills the gap behind your neck, cradling both sides for steady, balanced support.</p></div>
        <div class="cc-contour">
          <div class="cc-callouts"><div><b>Ergonomic 3D Contour</b><span>Cradles your neck and supports both sides.</span><span class="cc-meter" role="progressbar" aria-label="Ergonomic contour" aria-valuemin="0" aria-valuemax="100" aria-valuenow="94"><i style="--cc-progress:94%"></i></span></div><div><b>Premium Memory Foam</b><span>Slow rebound adapts gently to your shape.</span><span class="cc-meter" role="progressbar" aria-label="Memory foam comfort" aria-valuemin="0" aria-valuemax="100" aria-valuenow="92"><i style="--cc-progress:92%"></i></span></div></div>
          <div class="cc-product-stage">{% if section.settings.contour_image != blank %}{{ section.settings.contour_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', loading: 'lazy', alt: section.settings.contour_image.alt }}{% elsif product_image != blank %}{{ product_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', loading: 'lazy', alt: offer_product.title }}{% else %}<img src="{{ 'variant product 7.jpeg' | asset_url }}" width="800" height="800" loading="lazy" alt="Black neck pillow and lumbar support set">{% endif %}</div>
          <div class="cc-callouts cc-callouts-right"><div><b>Lumbar Support Curve</b><span>Supports the natural curve of your lower back.</span><span class="cc-meter" role="progressbar" aria-label="Lumbar support" aria-valuemin="0" aria-valuemax="100" aria-valuenow="90"><i style="--cc-progress:90%"></i></span></div><div><b>Adjustable Straps</b><span>Helps keep the cushion securely in place.</span><span class="cc-meter" role="progressbar" aria-label="Strap adjustability" aria-valuemin="0" aria-valuemax="100" aria-valuenow="96"><i style="--cc-progress:96%"></i></span></div></div>
        </div>
      </div>
    </section>

    <section class="cc-lifestyle">
      <div class="cc-lifestyle-media">{% if section.settings.comfort_image != blank %}{{ section.settings.comfort_image | image_url: width: 2400 | image_tag: widths: '750, 1200, 1800, 2400', sizes: '100vw', loading: 'lazy', alt: section.settings.comfort_image.alt }}{% elsif product_image != blank %}{{ product_image | image_url: width: 1800 | image_tag: widths: '750, 1200, 1800', loading: 'lazy', alt: offer_product.title }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'cc-placeholder' }}{% endif %}</div>
      <div class="cc-wrap cc-lifestyle-copy"><p class="cc-eyebrow">BLACK • GRAY • BROWN</p><h2>Comfort For Every Drive</h2><p>Timeless colors designed to feel at home in every interior.</p></div>
    </section>

    <section class="cc-section cc-wrap cc-care">
      <div><p class="cc-eyebrow">MADE FOR REAL LIFE</p><h2>Effortless Care For Every Drive</h2><p>Simply remove and wash the cover for easy, hassle-free everyday care.</p><div class="cc-feature"><span class="cc-icon"><img src="{{ 'quick-release-cover.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><div><h3>Quick-Release Cover</h3><p>Unzip and remove the cover easily whenever it needs a clean.</p></div></div><div class="cc-feature"><span class="cc-icon"><img src="{{ 'easy-machine-washing.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><div><h3>Easy Machine Washing</h3><p>Toss it in the washer to remove sweat and odors and refresh its comfort.</p></div></div></div>
      <div class="cc-care-media">{% if section.settings.care_image != blank %}{{ section.settings.care_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', loading: 'lazy', alt: section.settings.care_image.alt }}{% else %}{{ 'product-2' | placeholder_svg_tag: 'cc-placeholder' }}{% endif %}</div>
    </section>

    <section class="cc-section cc-inline-instant">
      <div class="cc-wrap">
        <div class="cc-heading"><h2>Instant Comfort, Every Drive</h2><p>Adaptive bounce and soft cushioning for every mile.</p></div>
        <div class="cc-inline-instant-grid">
          <article>
            <div class="cc-inline-instant-media">
              {% if section.settings.material_image_1 != blank %}{{ section.settings.material_image_1 | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.material_image_1.alt }}{% else %}<img src="{{ 'adaptive-rebound.jpg' | asset_url }}" width="1200" height="900" loading="lazy" alt="Memory foam demonstrating adaptive rebound">{% endif %}
            </div>
            <h3>Adaptive Rebound</h3><p>High-density foam provides responsive, long-lasting support.</p>
          </article>
          <article>
            <div class="cc-inline-instant-media">
              {% if section.settings.material_image_2 != blank %}{{ section.settings.material_image_2 | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.material_image_2.alt }}{% else %}<img src="{{ 'cloud-soft-plushness.jpg' | asset_url }}" width="1200" height="900" loading="lazy" alt="Close view of cloud-soft memory foam">{% endif %}
            </div>
            <h3>Cloud-Soft Plushness</h3><p>Plush memory foam delivers gentle, pressure-free comfort.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="cc-section cc-wrap cc-specs">
      <div><p class="cc-eyebrow">PRODUCT DETAILS</p><h2>Made For Everyday Comfort</h2><dl><div><dt>Product Name</dt><dd>{{ offer_product.title | default: 'Ergonomic Car Neck & Lumbar Support Set' }}</dd></div><div><dt>Cover Material</dt><dd>Soft, breathable removable cover</dd></div><div><dt>Filling Material</dt><dd>High-density memory foam</dd></div><div><dt>Attachment Type</dt><dd>Adjustable elastic straps</dd></div><div><dt>Dimensions</dt><dd>See selected variant</dd></div><div><dt>Care Instructions</dt><dd>Remove cover and machine wash; air dry</dd></div></dl></div>
      <div class="cc-spec-image">{% if section.settings.spec_image != blank %}{{ section.settings.spec_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', loading: 'lazy', alt: section.settings.spec_image.alt }}{% else %}<img src="{{ 'product-information.jpeg' | asset_url }}" width="800" height="800" loading="lazy" alt="Neck pillow and lumbar support dimensions">{% endif %}</div>
    </section>

    <div class="cc-promo" role="region" aria-label="Current promotions">
      <div class="cc-promo-track">
        <div class="cc-promo-group">
          <span>🔥 SAVE 30% ON BUNDLES</span><span>FREE SHIPPING OFFER</span><span>30-DAY GUARANTEE</span><span>🔥 SAVE 30% ON BUNDLES</span><span>FREE SHIPPING OFFER</span><span>30-DAY GUARANTEE</span><span>🔥 SAVE 30% ON BUNDLES</span><span>FREE SHIPPING OFFER</span><span>30-DAY GUARANTEE</span>
        </div>
        <div class="cc-promo-group" aria-hidden="true">
          <span>🔥 SAVE 30% ON BUNDLES</span><span>FREE SHIPPING OFFER</span><span>30-DAY GUARANTEE</span><span>🔥 SAVE 30% ON BUNDLES</span><span>FREE SHIPPING OFFER</span><span>30-DAY GUARANTEE</span><span>🔥 SAVE 30% ON BUNDLES</span><span>FREE SHIPPING OFFER</span><span>30-DAY GUARANTEE</span>
        </div>
      </div>
    </div>

    <section class="cc-product-section" id="cc-product-{{ section.id }}" aria-labelledby="cc-product-title-{{ section.id }}">
      <span id="special-offer" class="cc-product-anchor" aria-hidden="true"></span>
      <div class="cc-product-layout">
        <div class="cc-product-gallery{% if offer_product.media.size == 0 %} no-media{% endif %}" data-product-gallery>
          <div class="cc-product-thumbnails" role="tablist" aria-label="Product media">
            {% if offer_product.media.size > 0 %}
              {% for media in offer_product.media %}
                <button type="button" class="cc-product-thumbnail{% if media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %} is-active{% endif %}" data-media-target="media-{{ media.id }}" role="tab" aria-selected="{% if media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %}true{% else %}false{% endif %}" aria-label="View {{ media.media_type }} {{ forloop.index }}">
                  {{ media.preview_image | image_url: width: 160 | image_tag: widths: '80, 120, 160', sizes: '80px', loading: 'lazy', decoding: 'async', alt: media.alt }}
                  {% if media.media_type == 'video' or media.media_type == 'external_video' %}<span class="cc-product-play" aria-hidden="true">▶</span>{% endif %}
                </button>
              {% endfor %}
            {% endif %}
          </div>

          <div class="cc-product-media-stage" tabindex="0" aria-label="Selected product media">
            {% if offer_product.media.size > 0 %}
              {% for media in offer_product.media %}
                <div class="cc-product-media{% if media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %} is-active{% endif %}" data-media-id="media-{{ media.id }}" data-media-type="{{ media.media_type }}">
                  {% case media.media_type %}
                    {% when 'image' %}
                      {% if media.id == selected_variant.featured_media.id or selected_variant.featured_media == blank and forloop.first %}
                        {{ media | image_url: width: 1600 | image_tag: widths: '360, 540, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 42vw, 100vw', loading: 'eager', fetchpriority: 'high', decoding: 'async', alt: media.alt }}
                      {% else %}
                        {{ media | image_url: width: 1600 | image_tag: widths: '360, 540, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 42vw, 100vw', loading: 'lazy', fetchpriority: 'low', decoding: 'async', alt: media.alt }}
                      {% endif %}
                    {% when 'video' %}
                      {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
                    {% when 'external_video' %}
                      {{ media | external_video_tag }}
                    {% else %}
                      {{ media.preview_image | image_url: width: 1600 | image_tag: widths: '360, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 42vw, 100vw', loading: 'lazy', decoding: 'async', alt: media.alt }}
                  {% endcase %}
                </div>
              {% endfor %}
            {% else %}
              <div class="cc-product-media is-active cc-product-media-empty" data-media-id="empty" data-media-type="empty">{{ 'product-1' | placeholder_svg_tag }}<p>Add product media in Shopify admin.</p></div>
            {% endif %}
            <button type="button" class="cc-product-zoom" aria-label="Open larger product image">⌕</button>
            <span class="cc-product-counter" aria-live="polite">1/1</span>
          </div>
        </div>

          <div class="cc-product-info">
          <div class="cc-product-heading">
            <h2 id="cc-product-title-{{ section.id }}">{% if offer_product != blank %}{{ offer_product.title | escape }}{% else %}Select a Shopify product in Theme Editor{% endif %}</h2>
            {% if offer_product != blank and section.settings.show_reviews and product_rating != blank or offer_product != blank and section.settings.show_sold_count and product_sold_count != blank %}
              <div class="cc-product-rating" aria-label="Product rating and sales summary">
                {% if section.settings.show_reviews and product_rating != blank %}
                  <span class="cc-product-stars" style="--rating-width: {{ product_rating_percent }}%" role="img" aria-label="{{ product_rating }} out of 5 stars"><span aria-hidden="true">★★★★★</span></span>
                  <span class="cc-product-metric cc-product-score"><strong>{{ product_rating }}</strong><small>Average rating</small></span>
                  {% if product_review_count != blank %}<a class="cc-product-metric cc-product-reviews" href="#reviews"><strong>{{ product_review_count }}</strong><small>Reviews</small></a>{% endif %}
                {% endif %}
                {% if section.settings.show_sold_count and product_sold_count != blank %}<span class="cc-product-metric cc-product-sold"><strong>{{ product_sold_count }}</strong><small>Sold</small></span>{% endif %}
              </div>
            {% endif %}
          </div>

          <div class="cc-product-purchase">
            {% if section.settings.show_promotion %}
              <div class="cc-product-promo-head"><strong>{{ section.settings.promotion_title }}</strong>{% if section.settings.show_countdown %}<span>{{ section.settings.promotion_end }} · <b data-product-countdown data-hours="{{ section.settings.countdown_hours }}">00:00:00</b></span>{% endif %}</div>
            {% endif %}
            <div class="cc-product-price-box{% unless section.settings.show_promotion %} no-promo{% endunless %}">
              {% if selected_variant != blank %}
                <div class="cc-product-price-row"><span class="cc-product-current-price" data-current-price>{{ selected_variant.price | money }}</span><span class="cc-product-save{% unless selected_variant.compare_at_price > selected_variant.price %} is-hidden{% endunless %}" data-save-badge>Save <span data-save-amount>{{ selected_variant.compare_at_price | minus: selected_variant.price | money }}</span></span></div>
                <s class="cc-product-old-price{% unless selected_variant.compare_at_price > selected_variant.price %} is-hidden{% endunless %}" data-old-price>{{ selected_variant.compare_at_price | money }}</s>
              {% else %}
                <p class="cc-product-empty">Select a Shopify product to display its price.</p>
              {% endif %}
              <p class="cc-product-extra">{{ section.settings.extra_offer }}</p>
              {% if localization.country != blank %}<p class="cc-product-market-price"><span aria-hidden="true">◎</span> Price shown for <strong>{{ localization.country.name }}</strong> in <strong>{{ localization.country.currency.iso_code }}</strong></p>{% endif %}
            </div>

            {% if section.settings.show_coupon %}
              <details class="cc-product-coupon"><summary><span aria-hidden="true">%</span><strong>{{ section.settings.coupon_label }}</strong><span aria-hidden="true">⌄</span></summary><div>{{ section.settings.coupon_details }}</div></details>
            {% endif %}

            <div class="cc-product-divider"></div>

            {% if offer_product != blank %}
              {% form 'product', offer_product, id: product_form_id, class: 'cc-product-form-new' %}
                <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>
                {% for option in offer_product.options_with_values %}
                  <fieldset class="cc-product-option" data-option-position="{{ option.position }}">
                    <legend>{{ option.name }}: <strong data-selected-option>{{ option.selected_value }}</strong></legend>
                    <div class="cc-product-option-values">
                      {% for value in option.values %}
                        <button type="button" class="cc-product-option-value{% if value.selected %} is-selected{% endif %}{% unless value.available %} is-unavailable{% endunless %}" data-option-value="{{ value | escape }}" aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"{% unless value.available %} disabled{% endunless %}>
                          {% if section.settings.show_variant_thumbnails and option.position == 1 %}
                            {% assign value_variant = value.variant %}
                            {% if value_variant.featured_image != blank %}{{ value_variant.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: value }}{% endif %}
                          {% endif %}
                          <span>{{ value }}</span>
                        </button>
                      {% endfor %}
                    </div>
                  </fieldset>
                {% endfor %}

                <div class="cc-product-stock" data-stock><span></span>{% if selected_variant.available %}In stock{% else %}Sold out{% endif %}</div>
                {% if section.settings.show_quantity %}
                  <div class="cc-product-quantity-wrap"><label for="cc-quantity-{{ section.id }}">Quantity</label><div class="cc-product-quantity"><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input id="cc-quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div></div>
                {% else %}<input type="hidden" name="quantity" value="1">{% endif %}

                <div class="cc-product-actions">
                  <button class="cc-product-add" type="submit" name="add" data-add-button{% unless selected_variant.available %} disabled{% endunless %}>{% if selected_variant.available %}Add to Cart{% else %}Sold Out{% endif %}</button>
                  <button class="cc-product-buy-now" type="submit" name="return_to" value="/checkout" data-buy-button{% unless selected_variant.available %} disabled{% endunless %}>{% if selected_variant.available %}Buy Now{% else %}Sold Out{% endif %}</button>
                </div>
                <div class="cc-product-payment-methods">
                  <span>Secure payment methods</span>
                  <img src="{{ 'visa-mastercard-amex-paypal.jpg' | asset_url }}" width="2570" height="197" loading="lazy" alt="Accepted payment methods including Visa, Mastercard, American Express and PayPal">
                </div>
                <div class="cc-product-trust-grid" role="list" aria-label="Purchase guarantees">
                  <div class="cc-product-trust-item" role="listitem"><img src="{{ 'buyer-protection.png' | asset_url }}" width="1254" height="1254" loading="lazy" alt=""><strong>Buyer Protection</strong></div>
                  <div class="cc-product-trust-item" role="listitem"><img src="{{ '30-day-money-back-guarantee-section-product.png' | asset_url }}" width="1254" height="1254" loading="lazy" alt=""><strong>30-Day Money-Back Guarantee</strong></div>
                  <div class="cc-product-trust-item" role="listitem"><img src="{{ 'guaranteed-safe-checkout.png' | asset_url }}" width="1254" height="1254" loading="lazy" alt=""><strong>Guaranteed Safe Checkout</strong></div>
                </div>
              {% endform %}
            {% else %}
              <p class="cc-product-empty">Select an Active product published to the Online Store channel in Theme Editor.</p>
            {% endif %}
          </div>
        </div>
      </div>

      {% if offer_product != blank and section.settings.show_sticky_mobile %}<div class="cc-product-sticky"><button type="submit" name="add" form="{{ product_form_id }}" class="cc-product-add">Add to Cart</button><button type="submit" name="return_to" value="/checkout" form="{{ product_form_id }}" class="cc-product-buy-now">Buy Now</button></div>{% endif %}
      <dialog class="cc-product-lightbox"><button type="button" aria-label="Close image viewer">×</button><div></div></dialog>
      {% if offer_product != blank %}
        <script type="application/json" data-product-variants>{{ offer_product.variants | json }}</script>
        <script type="application/json" data-product-money>{
          {% for variant in offer_product.variants %}
            "{{ variant.id }}": {
              "price": {{ variant.price | money | json }},
              "compareAt": {{ variant.compare_at_price | money | json }},
              "savings": {{ variant.compare_at_price | minus: variant.price | money | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        }</script>
      {% endif %}
    </section>

    <section class="cc-section cc-guarantees" id="guarantees" style="background-image:url('{{ 'background-risk-free-purchase-peace-of-mind.jpg' | asset_url }}')"><div class="cc-wrap"><div class="cc-heading"><p class="cc-eyebrow">SHOP WITH CONFIDENCE</p><h2>Risk-Free Purchase, Peace of Mind</h2></div><div class="cc-guarantee-grid"><article><div class="cc-round-icon"><img src="{{ '30-day-money-back-guarantee.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></div><h3>30-Day Money-Back Guarantee</h3><p>Should we not meet your expectations, we offer a full refund within 30 days.</p></article><article><div class="cc-round-icon"><img src="{{ '24-7-quality-customer-service.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></div><h3>24/7 Quality Customer Service</h3><p>Our quality customer service team is here to help you 24 hours a day.</p></article><article><div class="cc-round-icon"><img src="{{ 'powered-by-real-users.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></div><h3>Powered by Real Users</h3><p>Real-user experience drives our development and testing to create the ultimate solution.</p></article></div></div></section>

    <section class="cc-section cc-wrap cc-faq" id="faq"><div class="cc-heading"><p class="cc-eyebrow">NEED TO KNOW</p><h2>Frequently Asked Questions</h2></div><details><summary>Will the cushions fit my car?</summary><p>The adjustable straps are designed to work with most standard car seats. Check the selected product details before ordering.</p></details><details><summary>Is the memory foam too firm or too soft?</summary><p>The high-density slow-rebound foam balances gentle cushioning with steady support.</p></details><details><summary>How do I clean the cover?</summary><p>Unzip and remove the outer cover, machine wash on a gentle cycle, then air dry. Do not wash the foam core.</p></details><details><summary>Can I use it outside the car?</summary><p>Yes. It can also add support to office chairs, gaming chairs, and suitable home seating.</p></details><details><summary>What if I am not satisfied?</summary><p>Contact customer service within 30 days so the team can help with the money-back guarantee process.</p></details></section>
  </div>

  <footer class="cc-footer"><div class="cc-wrap"><div><span class="cc-footer-icon"><img src="{{ 'fast-shipping.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><b>Fast Shipping</b><small>Quick delivery to your door.</small></div><div><span class="cc-footer-icon"><img src="{{ 'payment-security.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><b>Payment Security</b><small>Safe and secure checkout.</small></div><div><span class="cc-footer-icon"><img src="{{ '24-7-quality-customer-service.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><b>24/7 Service</b><small>We are here for you anytime.</small></div><div><span class="cc-footer-icon"><img src="{{ 'money-back-guarantee.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt=""></span><b>Money Back Guarantee</b><small>30-day risk-free confidence.</small></div></div></footer>
</div>

<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    const timer = root?.querySelector('[data-cc-countdown]');
    if (!timer || timer.dataset.ready) return;
    timer.dataset.ready = 'true';
    let remaining = 8 * 60 * 60 + 42 * 60 + 18;
    const tick = () => {
      remaining = Math.max(0, remaining - 1);
      timer.querySelector('[data-hours]').textContent = String(Math.floor(remaining / 3600)).padStart(2, '0');
      timer.querySelector('[data-minutes]').textContent = String(Math.floor((remaining % 3600) / 60)).padStart(2, '0');
      timer.querySelector('[data-seconds]').textContent = String(remaining % 60).padStart(2, '0');
    };
    setInterval(tick, 1000);
  })();

  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || root.dataset.ccMenuReady === 'true') return;
    root.dataset.ccMenuReady = 'true';
    const setMenu = (open) => {
      const menu = root.querySelector('[data-cc-mobile-menu]');
      const opener = root.querySelector('[data-cc-menu-open]');
      if (!menu || !opener) return;
      menu.setAttribute('aria-hidden', String(!open));
      opener.setAttribute('aria-expanded', String(open));
      root.classList.toggle('cc-menu-is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-cc-menu-open]')) {
        event.preventDefault();
        setMenu(true);
        return;
      }
      if (target.closest('[data-cc-menu-close], [data-cc-menu-overlay], [data-cc-mobile-menu] a')) {
        setMenu(false);
      }
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
  })();

  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    const bar = root?.querySelector('[data-cc-page-progress]');
    if (!root || !bar || root.dataset.ccProgressReady === 'true') return;
    root.dataset.ccProgressReady = 'true';
    let ticking = false;
    const update = () => {
      const rect = root.getBoundingClientRect();
      const distance = Math.max(1, root.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      bar.style.transform = `scaleX(${progress})`;
      ticking = false;
    };
    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  })();

  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    const faq = root?.querySelector('.cc-faq');
    if (!faq || faq.dataset.ccFaqReady === 'true') return;
    faq.dataset.ccFaqReady = 'true';
    const animations = new WeakMap();
    faq.querySelectorAll('details').forEach((item) => {
      const summary = item.querySelector('summary');
      const answer = item.querySelector('p');
      if (!summary || !answer) return;
      summary.setAttribute('aria-expanded', String(item.open));
      summary.addEventListener('click', (event) => {
        event.preventDefault();
        animations.get(item)?.cancel();
        const opening = summary.getAttribute('aria-expanded') !== 'true';
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          item.open = opening;
          summary.setAttribute('aria-expanded', String(opening));
          return;
        }
        if (opening) item.open = true;
        summary.setAttribute('aria-expanded', String(opening));
        const fullHeight = answer.scrollHeight;
        const animation = answer.animate(
          opening
            ? [
                { height: '0px', opacity: 0, transform: 'translateY(-6px)', paddingBottom: '0px' },
                { height: `${fullHeight}px`, opacity: 1, transform: 'translateY(0)', paddingBottom: '22px' },
              ]
            : [
                { height: `${fullHeight}px`, opacity: 1, transform: 'translateY(0)', paddingBottom: '22px' },
                { height: '0px', opacity: 0, transform: 'translateY(-6px)', paddingBottom: '0px' },
              ],
          { duration: opening ? 320 : 240, easing: 'cubic-bezier(.22,1,.36,1)' }
        );
        animations.set(item, animation);
        animation.onfinish = () => {
          if (!opening) item.open = false;
          answer.style.removeProperty('height');
          answer.style.removeProperty('opacity');
          answer.style.removeProperty('transform');
          answer.style.removeProperty('padding-bottom');
          animations.delete(item);
        };
        animation.oncancel = () => animations.delete(item);
      });
    });
  })();

  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    const gallery = root?.querySelector('.cc-offer-gallery');
    const mainImage = gallery?.querySelector('.cc-offer-main-image');
    const variantSelect = root?.querySelector('#cc-variant-{{ section.id }}');
    if (!gallery || !mainImage || gallery.dataset.ccGalleryReady === 'true') return;
    gallery.dataset.ccGalleryReady = 'true';

    let imageChangeId = 0;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const showImage = async (source, variantPosition) => {
      if (!source) return;
      const changeId = ++imageChangeId;

      gallery.querySelectorAll('.cc-thumb').forEach((thumb) => {
        const isMatch = variantPosition
          ? thumb.dataset.ccVariantPosition === variantPosition
          : thumb.dataset.ccProductImage === source;
        thumb.classList.toggle('is-active', isMatch);
        if (isMatch) thumb.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'nearest' });
      });

      const preload = new Image();
      preload.src = source;
      try {
        await preload.decode();
      } catch (error) {}
      if (changeId !== imageChangeId) return;

      if (!prefersReducedMotion) {
        await mainImage.animate(
          [
            { opacity: 1, transform: 'scale(1)' },
            { opacity: 0, transform: 'scale(.975)' },
          ],
          { duration: 150, easing: 'ease-out', fill: 'forwards' }
        ).finished.catch(() => {});
      }

      mainImage.src = source;
      mainImage.removeAttribute('srcset');
      mainImage.alt = variantPosition ? `Product variant ${variantPosition}` : mainImage.alt;

      if (!prefersReducedMotion) {
        mainImage.animate(
          [
            { opacity: 0, transform: 'scale(.975)' },
            { opacity: 1, transform: 'scale(1)' },
          ],
          { duration: 320, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'forwards' }
        );
      }
    };

    gallery.addEventListener('click', (event) => {
      const button = event.target.closest('[data-cc-product-image]');
      if (!button || !gallery.contains(button)) return;
      if (variantSelect && button.dataset.ccVariantPosition) {
        const matchingOption = Array.from(variantSelect.options).find(
          (option) => option.dataset.ccVariantPosition === button.dataset.ccVariantPosition
        );
        if (matchingOption && !matchingOption.disabled) variantSelect.value = matchingOption.value;
      }
      showImage(button.dataset.ccProductImage, button.dataset.ccVariantPosition);
    });

    variantSelect?.addEventListener('change', () => {
      const option = variantSelect.options[variantSelect.selectedIndex];
      showImage(option?.dataset.ccVariantImage, option?.dataset.ccVariantPosition);
    });
  })();

  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    const card = root?.querySelector('.cc-pain-grid .cc-video-card');
    const video = card?.querySelector('.cc-pain-hover-video');
    if (!card || !video || card.dataset.autoplayVideoReady === 'true') return;
    card.dataset.autoplayVideoReady = 'true';
    video.muted = true;
    video.defaultMuted = true;
    video.loop = true;
    video.playsInline = true;
    video.controls = false;
    video.removeAttribute('controls');

    video.autoplay = true;
    const startVideo = () => video.play().catch(() => {});
    if (video.readyState >= 2) startVideo();
    else video.addEventListener('canplay', startVideo, { once: true });
  })();

  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || root.dataset.scrollRevealReady === 'true') return;
    root.dataset.scrollRevealReady = 'true';
    const landing = root.querySelector('.cc-landing');
    if (!landing) return;

    const selectors = [
      '.cc-heading',
      '.cc-pain-grid > article',
      '.cc-contour > *',
      '.cc-lifestyle-copy',
      '.cc-care > *',
      '.cc-inline-instant-grid > article',
      '.cc-use-grid > article',
      '.cc-specs > *',
      '.cc-product-gallery',
      '.cc-product-info',
      '.cc-product-payment-methods',
      '.cc-product-trust-item',
      '.cc-guarantee-grid > article',
      '.cc-faq details',
      '.cc-footer .cc-wrap > div',
    ];
    const items = [...root.querySelectorAll(selectors.join(','))];
    items.forEach((item, index) => {
      item.dataset.scrollReveal = '';
      item.style.setProperty('--reveal-delay', `${(index % 4) * 70}ms`);
    });
    landing.classList.add('cc-reveal-ready');

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    items.forEach((item) => observer.observe(item));
  })();

  (() => {
    const section = document.getElementById('cc-product-{{ section.id }}');
    if (!section || section.dataset.productReady === 'true') return;
    section.dataset.productReady = 'true';

    const variantsNode = section.querySelector('[data-product-variants]');
    let variants = [];
    try {
      variants = variantsNode ? JSON.parse(variantsNode.textContent) : [];
    } catch (error) {
      console.error('Unable to load product variants', error);
    }
    const variantMoneyNode = section.querySelector('[data-product-money]');
    let variantMoney = {};
    try {
      variantMoney = variantMoneyNode ? JSON.parse(variantMoneyNode.textContent) : {};
    } catch (error) {
      console.error('Unable to load localized variant prices', error);
    }
    const optionGroups = [...section.querySelectorAll('[data-option-position]')];
    const variantIdInput = section.querySelector('[data-variant-id]');
    const currentPrice = section.querySelector('[data-current-price]');
    const oldPrice = section.querySelector('[data-old-price]');
    const saveBadge = section.querySelector('[data-save-badge]');
    const saveAmount = section.querySelector('[data-save-amount]');
    const stock = section.querySelector('[data-stock]');
    const purchaseButtons = [...section.querySelectorAll('[data-add-button], [data-buy-button], .cc-product-sticky button')];
    const mediaItems = [...section.querySelectorAll('.cc-product-media')];
    const thumbnails = [...section.querySelectorAll('.cc-product-thumbnail')];
    const counter = section.querySelector('.cc-product-counter');
    const stage = section.querySelector('.cc-product-media-stage');
    const lightbox = section.querySelector('.cc-product-lightbox');
    const moneyFormat = {{ shop.money_format | json }};
    const currencyCode = {{ localization.country.currency.iso_code | default: shop.currency | json }};
    const localeCode = {{ localization.language.iso_code | default: request.locale.iso_code | json }};
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const formatMoney = (cents) => {
      const value = Number(cents || 0);
      try {
        return new Intl.NumberFormat(localeCode || undefined, {
          style: 'currency',
          currency: currencyCode,
          currencyDisplay: 'narrowSymbol'
        }).format(value / 100);
      } catch (error) {
        // Fall back to the shop format if the visitor's browser lacks Intl data.
      }
      const token = moneyFormat.match(/\{\{\s*(\w+)\s*\}\}/)?.[1] || 'amount';
      let amount;
      if (token.includes('no_decimals')) amount = Math.round(value / 100).toLocaleString();
      else if (token.includes('comma_separator')) amount = (value / 100).toFixed(2).replace('.', ',');
      else amount = (value / 100).toFixed(2);
      return moneyFormat.replace(/\{\{\s*\w+\s*\}\}/, amount);
    };

    const showMedia = (target, scrollThumb = true) => {
      const next = mediaItems.find((item) => item.dataset.mediaId === target);
      if (!next) return;
      mediaItems.forEach((item) => {
        const active = item === next;
        item.classList.toggle('is-active', active);
        item.querySelectorAll('video').forEach((video) => { if (!active) video.pause(); });
      });
      thumbnails.forEach((thumb) => {
        const active = thumb.dataset.mediaTarget === target;
        thumb.classList.toggle('is-active', active);
        thumb.setAttribute('aria-selected', String(active));
        if (active && scrollThumb) thumb.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'nearest' });
      });
      const index = mediaItems.indexOf(next);
      if (counter) counter.textContent = `${index + 1}/${mediaItems.length}`;
    };

    const selectedValues = () => optionGroups.map((group) => group.querySelector('.is-selected')?.dataset.optionValue);
    const findVariant = (values) => variants.find((variant) => variant.options.every((value, index) => value === values[index]));

    const updateOptionAvailability = () => {
      const values = selectedValues();
      optionGroups.forEach((group, groupIndex) => {
        group.querySelectorAll('[data-option-value]').forEach((button) => {
          const candidate = [...values];
          candidate[groupIndex] = button.dataset.optionValue;
          const available = variants.some((variant) => variant.available && variant.options.every((value, index) => index === groupIndex ? value === candidate[index] : !candidate[index] || value === candidate[index]));
          button.classList.toggle('is-unavailable', !available);
          button.disabled = !available;
        });
      });
    };

    const updateVariant = (variant) => {
      if (!variant) return;
      if (variantIdInput) variantIdInput.value = variant.id;
      const localizedMoney = variantMoney[String(variant.id)] || {};
      if (currentPrice) currentPrice.textContent = localizedMoney.price || formatMoney(variant.price);
      const discounted = Number(variant.compare_at_price || 0) > Number(variant.price || 0);
      oldPrice?.classList.toggle('is-hidden', !discounted);
      saveBadge?.classList.toggle('is-hidden', !discounted);
      if (oldPrice && discounted) oldPrice.textContent = localizedMoney.compareAt || formatMoney(variant.compare_at_price);
      if (saveAmount && discounted) saveAmount.textContent = localizedMoney.savings || formatMoney(variant.compare_at_price - variant.price);
      if (stock) {
        stock.classList.toggle('is-sold-out', !variant.available);
        stock.lastChild.textContent = variant.available ? 'In stock' : 'Sold out';
      }
      purchaseButtons.forEach((button) => {
        button.disabled = !variant.available;
        button.textContent = variant.available ? (button.classList.contains('cc-product-add') ? 'Add to Cart' : 'Buy Now') : 'Sold Out';
      });
      const featuredId = variant.featured_media?.id || variant.featured_image?.id;
      if (featuredId) showMedia(`media-${featuredId}`);
      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url);
      updateOptionAvailability();
    };

    optionGroups.forEach((group) => {
      group.addEventListener('click', (event) => {
        const button = event.target.closest('[data-option-value]');
        if (!button || button.disabled) return;
        group.querySelectorAll('[data-option-value]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('is-selected', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        const label = group.querySelector('[data-selected-option]');
        if (label) label.textContent = button.dataset.optionValue;
        updateVariant(findVariant(selectedValues()));
      });
    });

    thumbnails.forEach((thumb) => thumb.addEventListener('click', () => showMedia(thumb.dataset.mediaTarget, false)));

    section.querySelector('[data-quantity-minus]')?.addEventListener('click', () => {
      const input = section.querySelector('.cc-product-quantity input');
      input.value = Math.max(1, Number(input.value || 1) - 1);
    });
    section.querySelector('[data-quantity-plus]')?.addEventListener('click', () => {
      const input = section.querySelector('.cc-product-quantity input');
      input.value = Math.max(1, Number(input.value || 1) + 1);
    });

    let touchStart = 0;
    stage?.addEventListener('touchstart', (event) => { touchStart = event.changedTouches[0].clientX; }, { passive: true });
    stage?.addEventListener('touchend', (event) => {
      const distance = event.changedTouches[0].clientX - touchStart;
      if (Math.abs(distance) < 45) return;
      const activeIndex = mediaItems.findIndex((item) => item.classList.contains('is-active'));
      const nextIndex = distance < 0 ? Math.min(mediaItems.length - 1, activeIndex + 1) : Math.max(0, activeIndex - 1);
      showMedia(mediaItems[nextIndex]?.dataset.mediaId);
    }, { passive: true });

    const openLightbox = () => {
      const active = section.querySelector('.cc-product-media.is-active');
      const image = active?.querySelector('img');
      if (!image || !lightbox?.showModal) return;
      const clone = image.cloneNode(true);
      clone.removeAttribute('loading');
      lightbox.querySelector('div').replaceChildren(clone);
      lightbox.showModal();
    };
    section.querySelector('.cc-product-zoom')?.addEventListener('click', openLightbox);
    stage?.addEventListener('dblclick', openLightbox);
    lightbox?.querySelector('button')?.addEventListener('click', () => lightbox.close());
    lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });

    const activeMedia = section.querySelector('.cc-product-media.is-active');
    showMedia(activeMedia?.dataset.mediaId, false);
    const initialVariant = variants.find((variant) => String(variant.id) === variantIdInput?.value);
    if (initialVariant) updateVariant(initialVariant);
    else updateOptionAvailability();

    const stickyBar = section.querySelector('.cc-product-sticky');
    if (stickyBar && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => stickyBar.classList.toggle('is-visible', entry.isIntersecting), { threshold: 0.05 }).observe(section.querySelector('.cc-product-layout'));
    } else stickyBar?.classList.add('is-visible');

    const countdown = section.querySelector('[data-product-countdown]');
    if (countdown) {
      const storageKey = 'cc-product-countdown-{{ section.id }}';
      const duration = Math.max(1, Number(countdown.dataset.hours || 8)) * 60 * 60 * 1000;
      let endTime = Number(sessionStorage.getItem(storageKey));
      if (!endTime || endTime <= Date.now()) {
        endTime = Date.now() + duration;
        sessionStorage.setItem(storageKey, String(endTime));
      }
      const renderCountdown = () => {
        const remaining = Math.max(0, endTime - Date.now());
        const hours = Math.floor(remaining / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        const seconds = Math.floor((remaining % 60000) / 1000);
        countdown.textContent = [hours, minutes, seconds].map((value) => String(value).padStart(2, '0')).join(':');
      };
      renderCountdown();
      setInterval(renderCountdown, 1000);
    }
  })();
</script>

<style>
  .cc-landing .cc-logo-image{display:block;width:auto;height:46px;object-fit:contain}
  @media(max-width:749px){.cc-landing .cc-logo-image{width:auto;height:36px}}
  .cc-landing .cc-announcement{background:#fff;color:#000}
  .cc-landing .cc-wrap{width:min(var(--page-content-width),calc(100% - var(--page-margin) * 2));margin-inline:auto}
