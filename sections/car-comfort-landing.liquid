  /* Clear, high-contrast announcement and navigation. */
  .cc-landing .cc-announcement {
    min-height: 40px;
    padding-inline: 20px;
    overflow: hidden;
    background: var(--cc-orange);
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .055em;
    line-height: 1.3;
    text-align: center;
  }
  .cc-landing .cc-marquee {
    align-items: center;
    justify-content: center;
    gap: 28px;
  }
  .cc-landing .cc-marquee span {
    display: inline-flex;
    align-items: center;
  }
  .cc-landing .cc-marquee span:not(:last-child)::after {
    content: '';
    width: 4px;
    height: 4px;
    margin-left: 28px;
    border-radius: 50%;
    background: currentColor;
    opacity: .7;
  }
  .cc-landing .cc-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: 80px;
    grid-template-columns: minmax(180px,1fr) auto minmax(240px,1fr);
    gap: 28px;
    border-bottom: 1px solid rgba(255,255,255,.1);
    box-shadow: 0 8px 24px rgba(10,18,32,.12);
  }
  .cc-landing .cc-logo {
    width: fit-content;
  }
  .cc-landing .cc-logo-image {
    max-width: 170px;
    height: 44px;
  }
  .cc-landing .cc-nav {
    gap: clamp(20px,2.4vw,38px);
  }
  .cc-landing .cc-nav a {
    padding-block: 12px;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .06em;
  }
  .cc-landing .cc-header-icon {
    background: rgba(255,255,255,.08);
    outline-offset: 3px;
  }
  .cc-landing .cc-header-icon:hover,
  .cc-landing .cc-header-icon:focus-visible {
    background: rgba(255,255,255,.16);
    transform: translateY(-2px);
  }
  .cc-landing .cc-header-cta {
    min-width: 116px;
    box-shadow: 0 6px 16px rgba(56,189,248,.24);
  }
  .cc-landing .cc-nav a:focus-visible,
  .cc-landing .cc-logo:focus-visible,
  .cc-landing .cc-button:focus-visible,
  .cc-landing .cc-menu-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (min-width: 750px) and (max-width: 1050px) {
    .cc-landing .cc-header {
      grid-template-columns: minmax(145px,1fr) auto minmax(96px,1fr);
      gap: 16px;
    }
    .cc-landing .cc-logo-image { max-width: 145px; }
    .cc-landing .cc-nav { gap: 18px; }
    .cc-landing .cc-header-cta { display: none; }
  }

  @media (max-width: 749px) {
    .cc-landing .cc-announcement {
      min-height: 38px;
      padding-inline: 0;
      font-size: .7rem;
    }
    .cc-landing .cc-marquee {
      width: max-content;
      justify-content: flex-start;
      gap: 28px;
      padding-inline: 20px;
      animation-duration: 22s;
    }
    .cc-landing .cc-header {
      height: 68px;
      padding: 0 16px;
      box-shadow: 0 6px 18px rgba(10,18,32,.16);
    }
    .cc-landing .cc-logo-image {
      max-width: 145px;
      height: 36px;
    }
    .cc-landing .cc-menu-toggle {
      width: 44px;
      height: 44px;
      border-color: rgba(255,255,255,.35)!important;
      border-radius: 10px;
      background: rgba(255,255,255,.08);
    }
    .cc-landing .cc-hero {
      min-height: clamp(620px,calc(100svh - 106px),760px);
      padding: clamp(42px,8vh,72px) 0 28px;
      align-items: flex-start;
      isolation: isolate;
    }
    .cc-landing .cc-hero-media img,
    .cc-landing .cc-hero-media .cc-placeholder {
      object-position: 68% center;
    }
    .cc-landing .cc-hero-overlay {
      background:
        linear-gradient(180deg,rgba(5,10,20,.92) 0%,rgba(5,10,20,.7) 38%,rgba(5,10,20,.18) 66%,rgba(5,10,20,.78) 100%),
        linear-gradient(90deg,rgba(5,10,20,.42),transparent 80%);
    }
    .cc-landing .cc-hero-content {
      display: flex;
      min-height: calc(clamp(620px,calc(100svh - 106px),760px) - clamp(70px,12vh,100px));
      flex-direction: column;
      align-items: flex-start;
    }
    .cc-landing .cc-hero-content .cc-eyebrow {
      margin-bottom: 12px;
      font-size: .7rem;
      line-height: 1.4;
      letter-spacing: .13em;
    }
    .cc-landing .cc-hero h1 {
      max-width: 10ch;
      margin-bottom: 16px;
      font-size: clamp(2.45rem,11vw,3.25rem);
      line-height: .98;
      text-wrap: balance;
    }
    .cc-landing .cc-hero-content > p:not(.cc-eyebrow) {
      max-width: 32ch;
      margin-bottom: 22px;
      font-size: .95rem;
      line-height: 1.55;
    }
    .cc-landing .cc-hero-content > .cc-button {
      width: min(100%,300px);
      min-height: 48px;
    }
    .cc-landing .cc-mini-trust {
      position: static;
      width: 100%;
      margin-top: auto;
      padding-top: 24px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      font-size: .72rem;
      line-height: 1.35;
    }
    .cc-landing .cc-mini-trust span {
      padding: 9px 12px;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 8px;
      background: rgba(5,10,20,.48);
      backdrop-filter: blur(6px);
    }
  }

  @media (max-width: 380px) {
    .cc-landing .cc-hero {
      min-height: 640px;
      padding-top: 36px;
    }
    .cc-landing .cc-hero-content { min-height: 576px; }
    .cc-landing .cc-hero h1 { font-size: 2.35rem; }
  }

