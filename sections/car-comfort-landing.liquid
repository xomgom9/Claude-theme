    #cc-product-{{ section.id }} .cc-product-heading { order: 1; padding: 15px; border: 1px solid var(--product-border); border-radius: 10px; background: var(--product-card); }
    #cc-product-{{ section.id }} .cc-product-gallery { order: 2; display: flex; padding: 0; flex-direction: column-reverse; gap: 0; overflow: hidden; border: 1px solid var(--product-border); border-radius: 10px; background: var(--product-card); }
    #cc-product-{{ section.id }} .cc-product-purchase { order: 3; margin: 0; padding: 14px; border: 1px solid var(--product-border); border-radius: 10px; background: var(--product-card); }
    #cc-product-{{ section.id }} .cc-product-heading h2 { font-size: 18px; }
    #cc-product-{{ section.id }} .cc-product-rating { gap: 7px; }
    #cc-product-{{ section.id }} .cc-product-stars { min-height: 44px; padding: 6px 9px; font-size: 21px; letter-spacing: 1px; }
    #cc-product-{{ section.id }} .cc-product-metric { min-width: 70px; min-height: 44px; padding: 5px 9px; }
    #cc-product-{{ section.id }} .cc-product-sold { min-width: 96px; }
    #cc-product-{{ section.id }} .cc-product-thumbnails { padding: 10px 12px 12px; flex-direction: row; max-height: none; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; scrollbar-width: none; }
    #cc-product-{{ section.id }} .cc-product-thumbnails::-webkit-scrollbar { display: none; }
    #cc-product-{{ section.id }} .cc-product-thumbnail { flex-basis: 58px; width: 58px; height: 58px; scroll-snap-align: start; }
    #cc-product-{{ section.id }} .cc-product-media-stage { width: 100%; border-radius: 9px 9px 0 0; }
    #cc-product-{{ section.id }} .cc-product-media { padding: 0; }
    #cc-product-{{ section.id }} .cc-product-current-price { font-size: 34px; }
    #cc-product-{{ section.id }} .cc-product-promo-head { align-items: flex-start; flex-wrap: wrap; }
    #cc-product-{{ section.id }} .cc-product-option-values { flex-wrap: nowrap; overflow-x: auto; padding: 2px 8px 8px 2px; scrollbar-width: none; }
    #cc-product-{{ section.id }} .cc-product-option-values::-webkit-scrollbar { display: none; }
    #cc-product-{{ section.id }} .cc-product-option-value { flex: 0 0 62px; }
    #cc-product-{{ section.id }} .cc-product-actions { display: none; }
    #cc-product-{{ section.id }} .cc-product-trust-grid { gap: 7px; }
    #cc-product-{{ section.id }} .cc-product-trust-item { min-height: 116px; padding: 11px 5px 9px; }
    #cc-product-{{ section.id }} .cc-product-trust-item > img { width: 48px; height: 48px; }
    #cc-product-{{ section.id }} .cc-product-trust-item > strong { font-size: 10px; }
    #cc-product-{{ section.id }} .cc-product-sticky { display: grid; position: fixed; z-index: 1000; right: 0; bottom: 0; left: 0; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); border-top: 1px solid var(--product-border); background: var(--product-card); box-shadow: 0 -4px 18px rgba(17,24,38,.08); opacity: 0; visibility: hidden; transform: translateY(100%); transition: opacity .22s ease, visibility .22s ease, transform .22s ease; }
    #cc-product-{{ section.id }} .cc-product-sticky.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
    #cc-product-{{ section.id }} .cc-product-sticky button { min-height: 50px; }
  }

  /* Vertical autoplay video in the driving-pain section. */
  .cc-landing .cc-pain-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
  }
  .cc-landing .cc-pain-grid .cc-media-card,
  .cc-landing .cc-pain-grid .cc-video-card {
    width: 100%;
    height: auto;
    min-height: 0;
    max-height: none;
    aspect-ratio: 4 / 5;
    align-self: stretch;
  }
  .cc-landing .cc-pain-grid .cc-video-card {
    background: #111826;
  }
  .cc-landing .cc-pain-grid .cc-video-card .cc-pain-hover-video {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: center;
  }
  .cc-landing .cc-pain-grid .cc-video-card .cc-play,
  .cc-landing .cc-pain-grid .cc-video-card video::-webkit-media-controls {
    display: none !important;
  }
  @media (max-width: 749px) {
    .cc-landing .cc-pain-grid .cc-video-card {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 5;
    }
  }

  .cc-landing.cc-reveal-ready [data-scroll-reveal] {
    transition-property: opacity, translate, scale;
    transition-duration: .65s;
    transition-delay: var(--reveal-delay, 0ms);
    transition-timing-function: cubic-bezier(.22, 1, .36, 1);
    will-change: opacity, translate, scale;
  }
  .cc-landing.cc-reveal-ready [data-scroll-reveal]:not(.is-visible) {
    opacity: 0;
    translate: 0 28px;
    scale: .985;
  }
  .cc-landing.cc-reveal-ready [data-scroll-reveal].is-visible {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  @media (max-width: 749px) {
    .cc-landing.cc-reveal-ready [data-scroll-reveal]:not(.is-visible) {
      translate: 0 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-landing.cc-reveal-ready [data-scroll-reveal] {
      opacity: 1 !important;
      translate: none !important;
      scale: none !important;
      transition: none !important;
    }
  }
</style>

