{% liquid
  assign heading_id = 'CareHeading-' | append: section.id
%}

<section
  class="cfd"
  aria-labelledby="{{ heading_id }}"
  style="--cfd-blue: {{ section.settings.accent_color }}; --cfd-radius: {{ section.settings.image_radius }}px;"
>
  <div class="cfd__grid">
    <header class="cfd__header">
      <h2 id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      <div class="cfd__intro">{{ section.settings.intro }}</div>
    </header>

    <div class="cfd__media" style="--cfd-x: {{ section.settings.image_x }}%; --cfd-y: {{ section.settings.image_y }}%; --cfd-mobile-x: {{ section.settings.mobile_image_x }}%; --cfd-mobile-y: {{ section.settings.mobile_image_y }}%;">
      {% if section.settings.mobile_image != blank %}
        {{ section.settings.mobile_image | image_url: width: 1200 | image_tag: class: 'cfd__image cfd__image--mobile', widths: '360, 540, 720, 960, 1200', sizes: '(max-width: 749px) calc(100vw - 32px), 1px', loading: 'lazy' }}
      {% endif %}
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'cfd__image cfd__image--desktop', widths: '540, 750, 960, 1200, 1600, 2000', sizes: '(min-width: 990px) 50vw, (min-width: 750px) 52vw, calc(100vw - 32px)', loading: 'lazy' }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'cfd__image cfd__image--desktop cfd__placeholder' }}
      {% endif %}
    </div>

    <div class="cfd__features">
      <article class="cfd__feature">
        <div class="cfd__icon-box" aria-hidden="true">
          {% if section.settings.feature_1_icon != blank %}
            {{ section.settings.feature_1_icon | image_url: width: 120 | image_tag: class: 'cfd__icon', widths: '48, 72, 96, 120', sizes: '48px', loading: 'lazy' }}
          {% else %}
            <img class="cfd__icon" src="{{ 'quick-release-cover.png' | asset_url }}" width="120" height="120" loading="lazy" alt="">
          {% endif %}
        </div>
        <div>
          <h3>{{ section.settings.feature_1_heading | escape }}</h3>
          <div class="cfd__feature-text">{{ section.settings.feature_1_text }}</div>
        </div>
      </article>

      <article class="cfd__feature">
        <div class="cfd__icon-box" aria-hidden="true">
          {% if section.settings.feature_2_icon != blank %}
            {{ section.settings.feature_2_icon | image_url: width: 120 | image_tag: class: 'cfd__icon', widths: '48, 72, 96, 120', sizes: '48px', loading: 'lazy' }}
          {% else %}
            <img class="cfd__icon" src="{{ 'easy-machine-washing.png' | asset_url }}" width="120" height="120" loading="lazy" alt="">
          {% endif %}
        </div>
        <div>
          <h3>{{ section.settings.feature_2_heading | escape }}</h3>
          <div class="cfd__feature-text">{{ section.settings.feature_2_text }}</div>
        </div>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .cfd {
    width: 100%;
    padding: 34px 35px;
    overflow: hidden;
    background: #fff;
    color: #111826;
  }
  .cfd, .cfd * { box-sizing: border-box; }
  .cfd__grid {
    display: grid;
    width: 100%;
    max-width: 1500px;
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "header media" "features media";
    column-gap: clamp(45px, 4vw, 60px);
    align-items: center;
  }
  .cfd__header { grid-area: header; align-self: end; }
  .cfd__header h2 {
    margin: 0;
    color: #111826;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 3vw, 2.5rem);
    font-weight: 780;
    line-height: 1.15;
    letter-spacing: -.04em;
  }
  .cfd__intro {
    margin-top: 25px;
    color: #566170;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.5;
  }
  .cfd__intro p, .cfd__feature-text p { margin: 0; }
  .cfd__features {
    display: grid;
    grid-area: features;
    gap: 26px;
    margin-top: 29px;
    align-self: start;
  }
  .cfd__feature {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .cfd__icon-box {
    display: grid;
    width: 48px;
    height: 48px;
    overflow: hidden;
    place-items: center;
    border-radius: 7px;
    background: var(--cfd-blue, #1684d6);
    color: #fff;
  }
  .cfd__icon { width: 68%; height: 68%; object-fit: contain; }
  .cfd__feature h3 {
    margin: 0 0 6px;
    color: #111826;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 1.65vw, 1.45rem);
    font-weight: 720;
    line-height: 1.2;
  }
  .cfd__feature-text {
    max-width: 560px;
    color: #667180;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.45;
  }
  .cfd__media {
    grid-area: media;
    width: 100%;
    height: clamp(400px, 32vw, 460px);
    overflow: hidden;
    border-radius: var(--cfd-radius, 16px);
    background: #eef8ff;
    box-shadow: 0 8px 24px rgba(17, 24, 38, .07);
  }
  .cfd__image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--cfd-x, 50%) var(--cfd-y, 50%); }
  .cfd__image--mobile { display: none; }

  @media (min-width: 750px) and (max-width: 989px) {
    .cfd { padding: 38px 24px; }
    .cfd__grid { grid-template-columns: minmax(0, 48fr) minmax(0, 52fr); column-gap: 30px; }
    .cfd__header h2 { font-size: clamp(1.9rem, 3.5vw, 2.125rem); }
    .cfd__intro { margin-top: 18px; }
    .cfd__features { gap: 20px; margin-top: 22px; }
    .cfd__feature { grid-template-columns: 44px minmax(0, 1fr); gap: 13px; }
    .cfd__icon-box { width: 44px; height: 44px; }
    .cfd__media { height: clamp(380px, 48vw, 420px); }
  }

  @media (max-width: 749px) {
    .cfd { padding: 40px 16px; }
    .cfd__grid { grid-template-columns: 1fr; grid-template-areas: "header" "media" "features"; }
    .cfd__header { text-align: center; }
    .cfd__header h2 { max-width: 15ch; margin-inline: auto; font-size: clamp(1.7rem, 8vw, 1.9rem); text-wrap: balance; }
    .cfd__intro { max-width: 42ch; margin: 12px auto 0; padding-inline: 10px; font-size: .875rem; line-height: 1.45; }
    .cfd__media { height: auto; margin-top: 24px; border-radius: min(var(--cfd-radius, 14px), 14px); aspect-ratio: 4 / 3; }
    .cfd__image--mobile { display: block; object-position: var(--cfd-mobile-x, 50%) var(--cfd-mobile-y, 50%); }
    .cfd__image--mobile + .cfd__image--desktop { display: none; }
    .cfd__features { gap: 23px; margin-top: 28px; }
    .cfd__feature { grid-template-columns: 44px minmax(0, 1fr); gap: 13px; }
    .cfd__icon-box { width: 44px; height: 44px; border-radius: 6px; }
    .cfd__feature h3 { font-size: 1.125rem; }
    .cfd__feature-text { font-size: .875rem; line-height: 1.45; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comfort for every drive",
  "tag": "section",
  "class": "comfort-for-every-drive-section",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Icon color", "default": "#1684d6" },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Effortless Care For Every Drive" },
    { "type": "richtext", "id": "intro", "label": "Description", "default": "<p>Simply remove and wash the cover for easy, hassle-free everyday care.</p>" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "range", "id": "image_x", "label": "Desktop horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_y", "label": "Desktop vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "mobile_image_x", "label": "Mobile horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "mobile_image_y", "label": "Mobile vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "header", "content": "Quick-release cover" },
    { "type": "image_picker", "id": "feature_1_icon", "label": "Icon" },
    { "type": "text", "id": "feature_1_heading", "label": "Heading", "default": "Quick-Release Cover" },
    { "type": "richtext", "id": "feature_1_text", "label": "Description", "default": "<p>Unzip and remove the cover easily whenever it needs a clean.</p>" },
    { "type": "header", "content": "Easy machine washing" },
    { "type": "image_picker", "id": "feature_2_icon", "label": "Icon" },
    { "type": "text", "id": "feature_2_heading", "label": "Heading", "default": "Easy Machine Washing" },
    { "type": "richtext", "id": "feature_2_text", "label": "Description", "default": "<p>Toss it in the washer to remove sweat and odors and refresh its comfort.</p>" }
  ],
  "presets": [{ "name": "Comfort for every drive" }]
}
{% endschema %}
