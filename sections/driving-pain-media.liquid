{% liquid
  assign heading_id = 'DrivingPainHeading-' | append: section.id
%}

<section class="dpm" aria-labelledby="{{ heading_id }}" style="--dpm-radius: {{ section.settings.radius }}px;">
  <div class="dpm__container">
    <header class="dpm__header">
      <h2 id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      <div>{{ section.settings.description }}</div>
    </header>

    <div class="dpm__grid">
      <article class="dpm__pain-card" style="--dpm-x: {{ section.settings.shoulder_x }}%; --dpm-y: {{ section.settings.shoulder_y }}%; --dpm-pain-x: {{ section.settings.shoulder_pain_x }}%; --dpm-pain-y: {{ section.settings.shoulder_pain_y }}%;">
        {% if section.settings.shoulder_image != blank %}
          {{ section.settings.shoulder_image | image_url: width: 1200 | image_tag: class: 'dpm__image', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 990px) 28vw, 50vw', loading: 'lazy' }}
        {% else %}
          <img class="dpm__image" src="{{ 'shoulder-back-strain.jpg' | asset_url }}" width="900" height="1200" loading="lazy" alt="Driver experiencing shoulder and back strain">
        {% endif %}
        <div class="dpm__pain-glow" aria-hidden="true"></div>
        <div class="dpm__gradient" aria-hidden="true"></div>
        <div class="dpm__card-copy"><h3>{{ section.settings.shoulder_heading | escape }}</h3><div>{{ section.settings.shoulder_text }}</div></div>
      </article>

      <article class="dpm__pain-card" style="--dpm-x: {{ section.settings.neck_x }}%; --dpm-y: {{ section.settings.neck_y }}%; --dpm-pain-x: {{ section.settings.neck_pain_x }}%; --dpm-pain-y: {{ section.settings.neck_pain_y }}%;">
        {% if section.settings.neck_image != blank %}
          {{ section.settings.neck_image | image_url: width: 1200 | image_tag: class: 'dpm__image', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 990px) 28vw, 50vw', loading: 'lazy' }}
        {% else %}
          <img class="dpm__image" src="{{ 'neck-pain-stiffness.jpg' | asset_url }}" width="900" height="1200" loading="lazy" alt="Driver experiencing neck pain and stiffness">
        {% endif %}
        <div class="dpm__pain-glow" aria-hidden="true"></div>
        <div class="dpm__gradient" aria-hidden="true"></div>
        <div class="dpm__card-copy"><h3>{{ section.settings.neck_heading | escape }}</h3><div>{{ section.settings.neck_text }}</div></div>
      </article>

      <div class="dpm__product-media" style="--dpm-x: {{ section.settings.media_x }}%; --dpm-y: {{ section.settings.media_y }}%;">
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: class: 'dpm__video', autoplay: section.settings.autoplay, loop: true, muted: true, playsinline: true, controls: section.settings.show_controls, image_size: '1600x' }}
        {% elsif section.settings.media_image != blank %}
          {{ section.settings.media_image | image_url: width: 1800 | image_tag: class: 'dpm__image dpm__product-image', widths: '540, 750, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'lazy' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'dpm__image dpm__placeholder' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    const video = root?.querySelector('.dpm__video');
    if (!video) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const syncMotion = () => {
      if (reduceMotion.matches) video.pause();
      else if ({{ section.settings.autoplay | json }}) video.play().catch(() => {});
    };
    syncMotion();
    reduceMotion.addEventListener?.('change', syncMotion);
  })();
</script>

{% stylesheet %}
  .dpm { width: 100%; padding: 42px 40px; overflow: hidden; background: #fff; color: #111826; }
  .dpm, .dpm * { box-sizing: border-box; }
  .dpm__container { width: 100%; max-width: 1500px; margin-inline: auto; }
  .dpm__header { margin: 0 auto 40px; text-align: center; }
  .dpm__header h2 { margin: 0; color: #111826; font-family: var(--font-heading--family); font-size: clamp(2.35rem, 3.2vw, 2.65rem); font-weight: 780; line-height: 1.15; letter-spacing: -.04em; }
  .dpm__header > div { max-width: 750px; margin: 12px auto 0; color: #596574; font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: 1.45; }
  .dpm__header p, .dpm__card-copy p { margin: 0; }
  .dpm__grid { display: grid; grid-template-columns: minmax(0, 28fr) minmax(0, 28fr) minmax(0, 40fr); gap: 24px; }
  .dpm__pain-card, .dpm__product-media { min-width: 0; height: 500px; position: relative; overflow: hidden; border-radius: var(--dpm-radius, 16px); background: #eaf7ff; box-shadow: 0 8px 24px rgba(17,24,38,.07); }
  .dpm__image, .dpm__video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--dpm-x, 50%) var(--dpm-y, 50%); }
  .dpm__pain-card .dpm__image { filter: grayscale(1) contrast(1.04); }
  .dpm__pain-glow { position: absolute; z-index: 1; inset: 0; pointer-events: none; background: radial-gradient(circle at var(--dpm-pain-x, 50%) var(--dpm-pain-y, 50%), rgba(255,35,35,.78) 0, rgba(255,35,35,.34) 8%, transparent 20%); mix-blend-mode: screen; }
  .dpm__gradient { position: absolute; z-index: 2; inset: 42% 0 0; background: linear-gradient(180deg, transparent, rgba(4,9,16,.9)); }
  .dpm__card-copy { position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; padding: 24px; color: #fff; text-align: left; }
  .dpm__card-copy h3 { margin: 0 0 9px; color: #fff; font-family: var(--font-heading--family); font-size: clamp(1.25rem, 1.65vw, 1.4rem); font-weight: 720; line-height: 1.2; }
  .dpm__card-copy > div { color: rgba(255,255,255,.88); font-size: clamp(.95rem, 1.15vw, 1.05rem); line-height: 1.5; }

  @media (min-width: 750px) and (max-width: 989px) {
    .dpm { padding: 38px 24px; }
    .dpm__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; }
    .dpm__pain-card { height: 380px; }
    .dpm__product-media { height: 380px; grid-column: 1 / -1; }
  }
  @media (max-width: 749px) {
    .dpm { padding: 40px 16px; }
    .dpm__header { margin-bottom: 27px; }
    .dpm__header h2 { max-width: 16ch; margin-inline: auto; font-size: clamp(1.7rem, 8vw, 1.9rem); text-wrap: balance; }
    .dpm__header > div { font-size: .875rem; line-height: 1.4; }
    .dpm__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
    .dpm__pain-card { height: clamp(250px,72vw,280px); border-radius: min(var(--dpm-radius,14px),14px); }
    .dpm__product-media { height: clamp(220px,64vw,260px); grid-column: 1 / -1; border-radius: min(var(--dpm-radius,14px),14px); }
    .dpm__card-copy { padding: 12px; }
    .dpm__card-copy h3 { margin-bottom: 7px; font-size: clamp(.875rem,4vw,1rem); }
    .dpm__card-copy > div { font-size: clamp(.68rem,3vw,.76rem); line-height: 1.35; }
    .dpm__gradient { inset-block-start: 32%; }
  }
  @media (max-width: 359px) {
    .dpm__grid { grid-template-columns: 1fr; gap: 10px; }
    .dpm__pain-card { height: 380px; }
    .dpm__product-media { height: 230px; grid-column: auto; }
    .dpm__card-copy { padding: 18px; }
    .dpm__card-copy h3 { font-size: 1.1rem; }
    .dpm__card-copy > div { font-size: .82rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Driving pain media",
  "tag": "section",
  "class": "driving-pain-media-section",
  "settings": [
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still Feeling Sore After Driving?" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Long hours behind the wheel can leave your neck, shoulders, and back feeling worn out.</p>" },
    { "type": "header", "content": "Shoulder and back strain" },
    { "type": "image_picker", "id": "shoulder_image", "label": "Image" },
    { "type": "text", "id": "shoulder_heading", "label": "Heading", "default": "Shoulder & Back Strain" },
    { "type": "richtext", "id": "shoulder_text", "label": "Description", "default": "<p>Tension builds up during long hours behind the wheel.</p>" },
    { "type": "range", "id": "shoulder_x", "label": "Image horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "shoulder_y", "label": "Image vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "shoulder_pain_x", "label": "Red glow horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 62 },
    { "type": "range", "id": "shoulder_pain_y", "label": "Red glow vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 38 },
    { "type": "header", "content": "Neck pain and stiffness" },
    { "type": "image_picker", "id": "neck_image", "label": "Image" },
    { "type": "text", "id": "neck_heading", "label": "Heading", "default": "Neck Pain & Stiffness" },
    { "type": "richtext", "id": "neck_text", "label": "Description", "default": "<p>Lack of support puts extra strain on your neck.</p>" },
    { "type": "range", "id": "neck_x", "label": "Image horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "neck_y", "label": "Image vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "neck_pain_x", "label": "Red glow horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 58 },
    { "type": "range", "id": "neck_pain_y", "label": "Red glow vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 34 },
    { "type": "header", "content": "Product media" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "media_image", "label": "Fallback image" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay video", "default": true },
    { "type": "checkbox", "id": "show_controls", "label": "Show video controls", "default": false },
    { "type": "range", "id": "media_x", "label": "Media horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "media_y", "label": "Media vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
  ],
  "presets": [{ "name": "Driving pain media" }]
}
{% endschema %}
