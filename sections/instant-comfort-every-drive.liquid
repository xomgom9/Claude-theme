{% liquid
  assign heading_id = 'InstantComfortHeading-' | append: section.id
%}

<section
  class="iced"
  aria-labelledby="{{ heading_id }}"
  style="--iced-radius: {{ section.settings.image_radius }}px;"
>
  <div class="iced__container">
    <header class="iced__header">
      <h2 id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      <div class="iced__intro">{{ section.settings.intro }}</div>
    </header>

    <div class="iced__grid">
      <article class="iced__feature">
        <div class="iced__media" style="--iced-x: {{ section.settings.rebound_x }}%; --iced-y: {{ section.settings.rebound_y }}%;">
          {% if section.settings.rebound_image != blank %}
            {{ section.settings.rebound_image | image_url: width: 1800 | image_tag: class: 'iced__image', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 990px) 645px, (min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
          {% else %}
            <img class="iced__image" src="{{ 'adaptive-rebound.jpg' | asset_url }}" width="1200" height="900" loading="lazy" alt="Adaptive memory foam rebound demonstration">
          {% endif %}
        </div>
        <div class="iced__copy">
          <h3>{{ section.settings.rebound_heading | escape }}</h3>
          <div>{{ section.settings.rebound_description }}</div>
        </div>
      </article>

      <article class="iced__feature">
        <div class="iced__media" style="--iced-x: {{ section.settings.plush_x }}%; --iced-y: {{ section.settings.plush_y }}%;">
          {% if section.settings.plush_image != blank %}
            {{ section.settings.plush_image | image_url: width: 1800 | image_tag: class: 'iced__image', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 990px) 645px, (min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
          {% else %}
            <img class="iced__image" src="{{ 'cloud-soft-plushness.jpg' | asset_url }}" width="1200" height="900" loading="lazy" alt="Close view of cloud-soft memory foam">
          {% endif %}
        </div>
        <div class="iced__copy">
          <h3>{{ section.settings.plush_heading | escape }}</h3>
          <div>{{ section.settings.plush_description }}</div>
        </div>
      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .iced {
    width: 100%;
    padding: clamp(56px, 6vw, 88px) 24px;
    overflow: hidden;
    background: #fff;
    color: #111826;
  }

  .iced,
  .iced * {
    box-sizing: border-box;
  }

  .iced__container {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
  }

  .iced__header {
    margin: 0 auto 66px;
    text-align: center;
  }

  .iced__header h2 {
    margin: 0;
    color: #111826;
    font-family: var(--font-heading--family);
    font-size: clamp(2.35rem, 3.2vw, 2.65rem);
    font-weight: 780;
    line-height: 1.15;
    letter-spacing: -.04em;
  }

  .iced__intro {
    margin-top: 25px;
    color: #566170;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .iced__intro p,
  .iced__copy p {
    margin: 0;
  }

  .iced__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px;
  }

  .iced__feature {
    min-width: 0;
    text-align: center;
  }

  .iced__media {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: var(--iced-radius, 18px);
    aspect-ratio: 4 / 3;
    background: #eef8ff;
  }

  .iced__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--iced-x, 50%) var(--iced-y, 50%);
    transition: transform .5s cubic-bezier(.22,1,.36,1);
  }


  .iced__copy {
    min-height: 102px;
    padding: 16px 22px 0;
  }

  .iced__copy h3 {
    margin: 0 0 10px;
    color: #111826;
    font-family: var(--font-heading--family);
    font-size: clamp(1.3rem, 1.8vw, 1.45rem);
    font-weight: 720;
    line-height: 1.2;
  }

  .iced__copy > div {
    max-width: 500px;
    margin-inline: auto;
    color: #667180;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.4;
  }

  @media (hover: hover) and (pointer: fine) {
    .iced__feature:hover .iced__image {
      transform: scale(1.045);
    }
  }

  @media (min-width: 750px) and (max-width: 989px) {
    .iced {
      padding: 58px 20px;
    }

    .iced__header {
      margin-bottom: 46px;
    }

    .iced__header h2 {
      font-size: 2.125rem;
    }

    .iced__grid {
      gap: 20px;
    }

  }

  @media (max-width: 749px) {
    .iced {
      padding: 48px 16px;
    }

    .iced__header {
      padding-inline: 4px;
      margin-bottom: 32px;
    }

    .iced__header h2 {
      max-width: 14ch;
      margin-inline: auto;
      font-size: clamp(1.7rem, 8vw, 1.9rem);
      line-height: 1.15;
      text-wrap: balance;
    }

    .iced__intro {
      margin-top: 12px;
      font-size: .875rem;
      line-height: 1.4;
    }

    .iced__grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .iced__media {
      border-radius: min(var(--iced-radius, 14px), 14px);
    }


    .iced__copy {
      min-height: 0;
      padding: 13px 10px 0;
    }

    .iced__copy h3 {
      margin-bottom: 7px;
      font-size: 1.25rem;
    }

    .iced__copy > div {
      padding-inline: 8px;
      font-size: .875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iced__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Instant comfort",
  "tag": "section",
  "class": "instant-comfort-every-drive-section",
  "settings": [
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Instant Comfort, Every Drive" },
    { "type": "richtext", "id": "intro", "label": "Description", "default": "<p>Adaptive bounce and soft cushioning for every mile.</p>" },

    { "type": "header", "content": "Adaptive rebound" },
    { "type": "image_picker", "id": "rebound_image", "label": "Image" },
    { "type": "text", "id": "rebound_heading", "label": "Heading", "default": "Adaptive Rebound" },
    { "type": "richtext", "id": "rebound_description", "label": "Description", "default": "<p>High-density foam provides responsive, long-lasting support.</p>" },
    { "type": "range", "id": "rebound_x", "label": "Horizontal image position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "rebound_y", "label": "Vertical image position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },

    { "type": "header", "content": "Cloud-soft plushness" },
    { "type": "image_picker", "id": "plush_image", "label": "Image" },
    { "type": "text", "id": "plush_heading", "label": "Heading", "default": "Cloud-Soft Plushness" },
    { "type": "richtext", "id": "plush_description", "label": "Description", "default": "<p>Plush memory foam delivers gentle, pressure-free comfort.</p>" },
    { "type": "range", "id": "plush_x", "label": "Horizontal image position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "plush_y", "label": "Vertical image position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
  ],
  "presets": [
    { "name": "Instant Comfort, Every Drive" }
  ]
}
{% endschema %}
